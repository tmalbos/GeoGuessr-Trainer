{
  "manifest_version": 3,
  "name": "GeoGuessr Pinpoint Trainer",
  "version": "0.2.1",
  "description": "Practica pinpointing: al empezar cada ronda de un mapa comunitario, el minimapa se centra con zoom y offset configurables cerca del lugar real.",
  "permissions": ["storage"],
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_title": "Pinpoint Trainer",
    "default_popup": "popup/popup.html",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  },
  "content_scripts": [
    {
      "matches": ["https://www.geoguessr.com/*"],
      "js": ["src/inject.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.geoguessr.com/*"],
      "js": ["src/bridge.js"],
      "run_at": "document_start"
    }
  ]
}
